# GetFit environment variables.
# For local development, copy this file to apps/web/.env.local (Next.js reads it from the app folder).
# Never commit real values (AGENTS §12). Every variable the app reads is documented here.

# --- Supabase (P1-04) ---------------------------------------------------------------
# Project URL and publishable key. Local values: `pnpm exec supabase status` (API_URL, PUBLISHABLE_KEY).
# Public by design: they reach the browser, and RLS protects the data. The secret key is never used by the app.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin of the app, used to build the links in auth emails (never taken from request headers).
# Must be allowed in Supabase Auth's redirect URLs (supabase/config.toml locally).
# On Vercel previews, leave it unset: the app uses Vercel's VERCEL_BRANCH_URL (docs/runbooks/preview-deployment.md).
APP_ORIGIN=http://localhost:3000

# --- Sentry: error monitoring (P1-15, PRD §12) ------------------------------------
# Leave empty to disable Sentry (local development and tests). A DSN is public by design: it reaches the browser.
NEXT_PUBLIC_SENTRY_DSN=
# Build time only, for source-map upload (CI and Vercel). All three must be set, or the upload is skipped.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- PostHog: product analytics, server-side only (P1-15, ADR 0006) ---------------
# Project API key (starts with phc_). Leave empty to disable analytics. Never exposed to the browser.
POSTHOG_API_KEY=
# EU region only (D17); any other host disables analytics.
POSTHOG_HOST=https://eu.i.posthog.com

# --- Rate limits (P4-08, D86) -------------------------------------------------------
# Secret for the HMAC that turns an email, IP or user ID into a rate-limit key, so none is stored in the database.
# A random string of at least 32 bytes, e.g. `openssl rand -base64 32`. Required in production and for every Vercel
# build; development and tests fall back to a fixed local value. Changing it resets every count.
RATE_LIMIT_SECRET=

# Test clock (D20): an ISO timestamp with an offset, e.g. 2026-11-23T08:00:00+01:00. Honoured only when
# NODE_ENV=test or VERCEL_ENV=preview; a production build fails if it is set. Leave empty everywhere else.
GETFIT_TEST_NOW=

# D95 (P4-02): set to "on" to register the service worker under `next dev` (the end-to-end tests do). Leave empty for
# everyday development; production builds always register it.
NEXT_PUBLIC_GETFIT_SERVICE_WORKER=
