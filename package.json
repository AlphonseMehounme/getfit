{
  "name": "getfit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @getfit/web dev",
    "build": "pnpm --filter @getfit/web build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --schema public > apps/web/server/db/types.ts && prettier --write --log-level warn apps/web/server/db/types.ts",
    "test:db": "vitest run --config tests/db/vitest.config.ts",
    "seed:generate": "node supabase/seed/generate.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@supabase/supabase-js": "2.119.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "supabase": "3.1.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
